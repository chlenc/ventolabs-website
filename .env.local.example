# Copy to .env.local for local dev overrides (e.g. a separate PostHog
# project for testing). For production, .env.production is committed
# with the real project token — NEXT_PUBLIC_* values end up in the
# client bundle anyway, so they aren't secrets.

NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Yandex.Metrika counter id. Leave empty locally — the tag and every
# reachGoal() call no-op without it, so dev traffic stays out of the counter.
NEXT_PUBLIC_YANDEX_METRIKA_ID=

# Webmaster ownership meta tags. Fill only with the real values issued by
# Yandex.Webmaster / Google Search Console; empty means no tag is emitted.
NEXT_PUBLIC_YANDEX_VERIFICATION=
NEXT_PUBLIC_GOOGLE_VERIFICATION=
