# Production env for Next.js build. Values here are baked into the
# client bundle (NEXT_PUBLIC_*) so by design they aren't secret.
# GitHub Actions `env:` blocks in deploy.yml override these when set.

NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_uQFdAzxqsv6amVCHYjpXLZZsgDiFp3gjervHPBfrmP3e
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Yandex.Metrika counter for ventolabs.com (created 21.09.2026, Webvisor on).
NEXT_PUBLIC_YANDEX_METRIKA_ID=112880923

# Yandex.Webmaster ownership is verified by a DNS TXT record on the apex
# domain, so no meta tag is needed. Kept empty on purpose — setting it would
# render a second, redundant ownership tag.
NEXT_PUBLIC_YANDEX_VERIFICATION=
